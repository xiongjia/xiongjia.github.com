# python
*.py[cod]
*.pyc
*.pyo
__pycache__/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.venv/
# bot worktree symlink to the main repo venv (a symlink is a file, so the
# trailing-slash rule above doesn't match it — anchor a bare one as well)
/.venv

# mkdocs folders
site/
site-selfhost/
.cache/

# research source clones (never committed; nested external/.gitignore kept as defense-in-depth)
/external/

# env files — local secrets; keep .env.example tracked
.env
.env.*
!.env.example
env-*

# claude code — track skills, ignore local settings
.claude/*
!.claude/skills/

# pi coding agent — commit shared skills/prompts, ignore personal config & artifacts
.pi/*
!.pi/skills/
!.pi/prompts/
!.pi/agents/
!.pi/chains/

# personal config & local artifacts (never commit)
.pi/settings.json
.pi/.mung/
.pi/npm/
.pi/sessions/

# pi subagents (auto-generated workspace)
.pi-subagents/

# local draft files
*-draft.md

# bot plan files — personal daily routines (e.g. .bot/plans/morning.yml);
# local-only, `poe bot --plan <name>` reads them from here regardless
.bot/

# bot instance marker (worktree-local; must never be committed)
.bot-active

# bucket-managed large assets (R2/S3; local copies kept for VSCode preview)
# trailing-slash rule matches the real dir; the bot worktree symlink is a
# file, so anchor a bare path as well
docs/assets/bucket/
/docs/assets/bucket

# downloaded mermaid assets (auto-downloaded during build)
docs/assets/javascripts/mermaid.*
docs/.mermaid-version
# Build metadata
*.egg-info/
# Python coverage artifacts
.coverage
.coverage.*

# Bot Remote API runtime data (git-ignored; dir configurable via BOT_API_LOG_DIR)
.bot-api/

# bucket-upload staging dir (converted WebP before upload; git-ignored, dir
# configurable via extra.bucket.upload.tmp_dir / BUCKET_UPLOAD_TMP_DIR)
.bucket/
# Garmin API cache for running track splits/polyline data
.running/

# anki export output (generated by `poe enu export`; card source lives in docs)
.anki/

