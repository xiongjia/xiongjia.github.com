# python
*.py[cod]
*.pyc
*.pyo
__pycache__/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.venv/

# mkdocs folders
site/
site-selfhost/
.cache/

# env files
.env
env-*

# claude code — track skills, ignore local settings
.claude/*
!.claude/skills/

# pi coding agent — commit shared skills/prompts, ignore personal config & artifacts
.pi/*
!.pi/skills/
!.pi/prompts/
!.pi/agents/
!.pi/chains/

# personal config & local artifacts (never commit)
.pi/settings.json
.pi/.mung/
.pi/npm/
.pi/sessions/

# pi subagents (auto-generated workspace)
.pi-subagents/

# local draft files
*-draft.md

# downloaded mermaid assets (auto-downloaded during build)
docs/assets/javascripts/mermaid.*
docs/.mermaid-version
# Build metadata
*.egg-info/
