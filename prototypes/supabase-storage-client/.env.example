# Supabase Storage configuration — copy this file to .env.dev.local and adjust.
# .env.dev.local (and .env) is gitignored; never commit real credentials.
#
# For a local Supabase instance (`supabase start`) the defaults work out of the
# box: the URL is the fixed local endpoint and the anon key is auto-read from
# the running project via `supabase status -o env` when not set here.

# Local Supabase API URL (what `supabase start` prints for the REST API).
SUPABASE_URL=http://127.0.0.1:64321

# Public (anon) API key of the local Supabase project.
#
# What it is: a public, browser-safe JWT that identifies the project. It is
# NOT a secret — by design it ships in every frontend — so it is fine to
# commit/read freely. (The *service_role* key, by contrast, bypasses RLS and
# must never leave the server; this prototype never uses it.)
#
# Where it comes from: `supabase start` prints it, `supabase status` shows it
# in the table view, and it is also visible in Studio → Settings → API.
#
# Here it can be left empty: the demo auto-reads ANON_KEY from the running
# project via `supabase status -o env`. Only set it explicitly when that CLI
# lookup fails or when you point the demo at a non-local (hosted) project,
# whose anon key you copy from the project dashboard.
# SUPABASE_ANON_KEY=

# Demo bucket — the demo creates it (private) and removes it afterwards
# (unless SUPABASE_KEEP_DEMO_OBJECT is set).
SUPABASE_BUCKET=supabase-storage-demo

# Demo object key prefix inside the bucket — the demo only touches keys under
# this prefix.
# SUPABASE_DEMO_PREFIX=demo/supabase-storage-client/

# Keep the demo object and bucket after the run (default: false). Set to true
# to skip the demo's automatic cleanup — needed to curl-test the signed
# upload URL after the demo exits (see README).
# SUPABASE_KEEP_DEMO_OBJECT=true
