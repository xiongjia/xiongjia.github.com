# Copy to .env and adjust. Every key is validated at boot (src/config/env.ts).
# Unknown keys are ignored; invalid values fail the boot with a list of issues.

# ---- server (no auth layer — keep it on loopback) ----------------------------
HARVEST_HOST=127.0.0.1
HARVEST_PORT=8765

# ---- engine -----------------------------------------------------------------
# Leave it unset (recommended): every profile uses the engine recorded in its own
# profile.json, and a new profile is created as `camoufox`.
# Set it to override *all* profiles — this is the engine switch:
#   camoufox     = patched Firefox, the default. Needs its build once:
#                  "pnpm camoufox:fetch" (CAMOUFOX_MIRROR / CAMOUFOX_ZIP supported)
#   patchright   = drives your installed Chrome, nothing to download
#   cloakbrowser = stealth Chromium. Needs its build once ("pnpm cloakbrowser:install",
#                  ~200 MB) and a license key for builds after v146
#                  ("pnpm exec cloakbrowser login": free with a GitHub sign-in, but
#                  ONE concurrent session — i.e. one profile at a time)
#   mock         = tests only
# Each engine gets its own browser directory, so switching does not throw the
# other engine's login away (Chrome and Firefox cannot share one profile).
# HARVEST_BROWSER=camoufox

# patchright only — ignored by the other engines.
# chrome = locally installed Google Chrome | chromium = bundled build
# (run "pnpm browser:install" first)
HARVEST_CHANNEL=chrome

# Camoufox downloads its default addons (uBO) on launch; addons.mozilla.org
# answers 451 in some regions. Empty string = keep the default addons.
HARVEST_EXCLUDE_ADDONS=uBO

# ---- releasing the browser ---------------------------------------------------
# The context stays warm between runs (that is what makes "log in once" cheap).
# Set a number to give the memory back: a context idle this many ms is closed.
# Cookies and the fingerprint stay in the profile directory, so the only cost is
# the next launch (~2-6 s). Runs in flight are never interrupted.
# 0 (default) = keep it warm until the process exits.
HARVEST_BROWSER_IDLE_MS=0
# On demand instead: POST /api/v1/browser/close (?profile=<name> for one).

# ---- CloakBrowser (HARVEST_BROWSER=cloakbrowser) -----------------------------
# Read by the library itself, so these are not part of the validated HARVEST_*
# set. The ~200 MB build is cached in CLOAKBROWSER_CACHE_DIR (containers:
# /app/.cloakbrowser). Never swap the binary under a running profile — upgrade on
# purpose with "pnpm cloakbrowser:update" instead.
CLOAKBROWSER_AUTO_UPDATE=false
# Builds after v146 need a key; the free one allows one concurrent session.
# CLOAKBROWSER_LICENSE_KEY=cb_xxxxxxxx
# Drive your own Chromium build instead of downloading one.
# CLOAKBROWSER_BINARY_PATH=/Applications/Chromium.app/Contents/MacOS/Chromium

# ---- how visible the browser is ---------------------------------------------
# true    = headless
# false   = show the real window (best for watching a run)
# virtual = headed on an Xvfb display (containers)
HARVEST_HEADLESS=true
# Milliseconds between browser actions; set e.g. 250 to watch the automation
HARVEST_SLOWMO=0

# ---- state ------------------------------------------------------------------
# Persistent profile (fingerprint + cookies) and scraped output
HARVEST_PROFILE_DIR=.cache/profile
HARVEST_DATA_DIR=data

# ---- xiaohongshu ------------------------------------------------------------
# Session jar written by GET /api/v1/xhs/login/status (mode 0600)
HARVEST_XHS_COOKIES=.cache/xhs-cookies.json
# How long the login page may take to paint the QR before falling back to a
# viewport screenshot (the risk-control redirect also has to fit in here)
HARVEST_XHS_SETTLE_MS=8000

# ---- fingerprint (keep aligned with the account's region) --------------------
# Fingerprint OS: macos | windows | linux. Defaults to the host OS — claiming a
# different OS makes Camoufox advertise fonts that do not exist locally, and CJK
# text then renders as boxes.
# HARVEST_OS=macos

HARVEST_LOCALE=zh-CN
HARVEST_TIMEZONE=Asia/Shanghai
HARVEST_VIEWPORT_WIDTH=1280
HARVEST_VIEWPORT_HEIGHT=800
