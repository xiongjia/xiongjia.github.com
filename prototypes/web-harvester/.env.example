# Copy to .env and adjust. Every key is validated at boot (src/config/env.ts).
# Unknown keys are ignored; invalid values fail the boot with a list of issues.

# ---- server (no auth layer — keep it on loopback) ----------------------------
HARVEST_HOST=127.0.0.1
HARVEST_PORT=8765

# ---- engine -----------------------------------------------------------------
# camoufox  = patched Firefox, the default. Needs its build once:
#             "pnpm camoufox:fetch" (CAMOUFOX_MIRROR / CAMOUFOX_ZIP supported)
# patchright = drives your installed Chrome, nothing to download
# mock      = tests only
HARVEST_BROWSER=camoufox

# patchright only — ignored when HARVEST_BROWSER=camoufox.
# chrome = locally installed Google Chrome | chromium = bundled build
# (run "pnpm browser:install" first)
HARVEST_CHANNEL=chrome

# Camoufox downloads its default addons (uBO) on launch; addons.mozilla.org
# answers 451 in some regions. Empty string = keep the default addons.
HARVEST_EXCLUDE_ADDONS=uBO

# ---- how visible the browser is ---------------------------------------------
# true    = headless
# false   = show the real window (best for watching a run)
# virtual = headed on an Xvfb display (containers)
HARVEST_HEADLESS=true
# Milliseconds between browser actions; set e.g. 250 to watch the automation
HARVEST_SLOWMO=0

# ---- state ------------------------------------------------------------------
# Persistent profile (fingerprint + cookies) and scraped output
HARVEST_PROFILE_DIR=.cache/profile
HARVEST_DATA_DIR=data

# ---- xiaohongshu ------------------------------------------------------------
# Session jar written by GET /api/v1/xhs/login/status (mode 0600)
HARVEST_XHS_COOKIES=.cache/xhs-cookies.json
# How long the login page may take to paint the QR before falling back to a
# viewport screenshot (the risk-control redirect also has to fit in here)
HARVEST_XHS_SETTLE_MS=8000

# ---- fingerprint (keep aligned with the account's region) --------------------
# Fingerprint OS: macos | windows | linux. Defaults to the host OS — claiming a
# different OS makes Camoufox advertise fonts that do not exist locally, and CJK
# text then renders as boxes.
# HARVEST_OS=macos

HARVEST_LOCALE=zh-CN
HARVEST_TIMEZONE=Asia/Shanghai
HARVEST_VIEWPORT_WIDTH=1280
HARVEST_VIEWPORT_HEIGHT=800
