{
  "$schema": "./flow.schema.json",
  "name": "xhs-login-qr",
  "version": 2,
  "apiVersion": 1,
  // One account, one site: every xhs flow shares this gap so a burst of calls
  // (manual or automated) cannot look like a bot. Other flows are untouched.
  "throttle": { "scope": "xhs", "minIntervalMs": 20000 },
  "sync": true,
  "description": "Short flow: put the login QR on screen as artifacts/qr.png and stop. Kept for `?artifact=qr` (inspect the code, check the selectors); it is NOT a login — the run ends by closing the page, so use xhs-login-scan when the code has to be scanned.",
  "steps": [{ "action": "include", "flow": "xhs-qr-open" }]
}
