# pg-boss-demo configuration.
# Copy this file to .env.dev.local and fill in your values:
#   cp .env.example .env.dev.local
# .env.dev.local / .env are gitignored — never commit real credentials.
# Loaded by @nestjs/config at startup (.env.dev.local takes precedence).

# --- Application ---
NODE_ENV=development
PORT=3000

# --- PostgreSQL ---
# Same credentials as the docker compose `db` service (see docker-compose.yml).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=pgboss
DB_PASSWORD=pgboss
DB_NAME=pgboss

# --- pg-boss queue defaults ---
# Applied to the demo queues when they are created at startup.
# Schema that pg-boss installs — auto-created by start().
PGBOSS_SCHEMA=pgboss
# Max retries before a job is marked failed (v12 default 2).
PGBOSS_RETRY_LIMIT=2
# Base delay between retries, seconds.
PGBOSS_RETRY_DELAY=5
# v12: boolean — exponential backoff on top of retryDelay.
PGBOSS_RETRY_BACKOFF=true
# Active-job timeout, seconds — a crashed worker's job is retried after this.
PGBOSS_EXPIRE_SECONDS=300
# How long completed jobs stay queryable (0 = forever). This is what makes the
# "query job result" API work (v12 field: deleteAfterSeconds).
PGBOSS_DELETE_AFTER_SECONDS=3600
# Per-queue worker concurrency for the demo queues.
PGBOSS_WORKER_CONCURRENCY=3

# --- Swagger ---
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs
