{
  "name": "@frontend-lab/lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "content:index": "node plugins/content-index.ts",
    "content:check": "node plugins/content-check.ts",
    "demos:index": "node plugins/demo-registry.ts",
    "generate": "pnpm content:index && pnpm demos:index",
    "test": "node --test",
    "build": "pnpm generate && pnpm content:check && pnpm style:check && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "pnpm generate && tsc --noEmit",
    "style:check": "node plugins/style-check.ts",
    "bundle:report": "node plugins/bundle-report.ts",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@frontend-lab/charts": "workspace:*",
    "@frontend-lab/command-palette": "workspace:*",
    "@frontend-lab/editor": "workspace:*",
    "@frontend-lab/panels": "workspace:*",
    "@frontend-lab/state": "workspace:*",
    "@frontend-lab/ui": "workspace:*",
    "@frontend-lab/workspace": "workspace:*",
    "@lezer/highlight": "^1.2.5",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
