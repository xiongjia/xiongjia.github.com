{
  "name": "frontend-lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @frontend-lab/lab dev",
    "generate": "pnpm --filter @frontend-lab/lab generate",
    "content:index": "pnpm --filter @frontend-lab/lab content:index",
    "content:check": "pnpm --filter @frontend-lab/lab content:check",
    "demos:index": "pnpm --filter @frontend-lab/lab demos:index",
    "build": "pnpm --filter @frontend-lab/lab build",
    "preview": "pnpm --filter @frontend-lab/lab preview",
    "test": "pnpm --filter @frontend-lab/lab test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm content:check && pnpm style:check && pnpm lint && pnpm format:check && pnpm test",
    "style:check": "pnpm --filter @frontend-lab/lab style:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
