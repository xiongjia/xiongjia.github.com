{
  "name": "protomaps-map-view",
  "version": "0.1.0",
  "private": true,
  "description": "Prototype: a generic React MapView component on Protomaps basemaps (maplibre-gl + pmtiles + @protomaps/basemaps), Vite + pnpm",
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:widget": "vite build --config vite.lib.config.ts",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "warm:glyphs": "tsx scripts/warm-glyphs.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@protomaps/basemaps": "^5.7.2",
    "maplibre-gl": "^5.24.0",
    "pmtiles": "^4.4.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.5",
    "dotenv": "^17.4.2",
    "jsdom": "^30.0.1",
    "pbf": "^5.1.2",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.9",
    "typescript": "^5.9.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
