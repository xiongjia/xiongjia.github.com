# Local basemap tiles configuration.
# Copy this file to `.env.local` (gitignored) and adjust if needed.
# Both variables are optional — these defaults are used when unset.

# Directory holding your local *.pmtiles files, relative to this project root,
# inside the gitignored .cache/ dir: manually copy your basemap file(s) into
# it, e.g. `.cache/pmtiles/shanghai.pmtiles`.
VITE_PMTILES_DIR=.cache/pmtiles

# Basemap file name inside the tiles directory.
VITE_PMTILES_FILE=shanghai.pmtiles

# Local glyph (label font) cache directory, relative to this project root.
# The glyph-proxy plugin downloads each needed font PBF once from the upstream
# fonts host into this gitignored dir, then serves it locally (fully offline
# after the first warm-up pass).
VITE_GLYPHS_DIR=.cache/glyphs

# Glyph font source: protomaps (smallest, ~4 MB, but no CJK glyphs) or
# maplibre (demotiles.maplibre.org, ~55 MB, real CJK; "Noto Sans Medium"
# is served from Bold). Must match `pnpm warm:glyphs --source=...`.
VITE_GLYPHS_SRC=protomaps
