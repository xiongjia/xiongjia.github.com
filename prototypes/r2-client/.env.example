# Cloudflare R2 configuration — copy this file to .env.dev.local and fill in your values.
# .env.dev.local (and .env) is gitignored; never commit real credentials.

# Cloudflare account ID — dashboard → right sidebar ("Account ID"). Used to
# build the S3 endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=

# R2 API token (Access Key ID / Secret). Create it in the R2 dashboard:
# R2 Object Storage → Manage R2 API Tokens → Create API Token.
# Use the "Admin Read & Write" permission — the demo lists buckets and
# creates/deletes its demo bucket (an object-only token cannot do that).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Bucket name (create it in the R2 dashboard: R2 Object Storage → Create bucket).
# The demo creates it automatically when missing (R2 buckets are private by default).
R2_BUCKET=

# Region string sent to the S3 API. R2 ignores the value — "auto" is what
# Cloudflare's own examples use. A local MinIO test needs us-east-1.
# R2_REGION=auto

# Custom endpoint (optional). Overrides the account-derived S3 endpoint
# (https://<ACCOUNT_ID>.r2.cloudflarestorage.com) — e.g. a local MinIO for
# testing without a Cloudflare account (see README → Local test).
# R2_ENDPOINT=

# Force path-style addressing (optional). Needed by local MinIO (localhost has
# no DNS for virtual-hosted buckets); not needed for real R2.
# R2_FORCE_PATH_STYLE=true

# Demo object key prefix — the demo only touches keys under this prefix.
# R2_DEMO_PREFIX=demo/r2-client/

# Keep the demo object after the run (default: false). Set to true to skip
# the demo's automatic cleanup — needed to curl-test the presigned upload
# URL after the demo exits (see README → Testing a presigned upload URL with curl).
# R2_KEEP_DEMO_OBJECT=true
