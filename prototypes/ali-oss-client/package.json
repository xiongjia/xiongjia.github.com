{
  "name": "ali-oss-client",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript prototype: basic Aliyun OSS usage with the official ali-oss SDK",
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/index.ts",
    "demo": "node dist/index.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "ali-oss": "^6.22.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/ali-oss": "^6.23.3",
    "@types/node": "^24.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
