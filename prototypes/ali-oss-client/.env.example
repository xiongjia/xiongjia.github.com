# Aliyun OSS configuration — copy this file to .env.dev.local and fill in your values.
# .env.dev.local (and .env) is gitignored; never commit real credentials.

# Bucket region, e.g. oss-cn-hangzhou / oss-cn-shanghai / oss-cn-beijing.
# Used by the SDK to build the endpoint (https://<region>.aliyuncs.com).
ALIYUN_OSS_REGION=oss-cn-hangzhou

# Custom endpoint (optional). Overrides the region-based endpoint, e.g.
# https://oss-cn-hangzhou.aliyuncs.com or your own CNAME.
# ALIYUN_OSS_ENDPOINT=

# Bucket name, e.g. my-bucket
ALIYUN_OSS_BUCKET=

# RAM user credentials (AccessKey ID / Secret). Create them in the RAM console:
# https://ram.console.aliyun.com
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=

# Demo object key prefix — the demo only touches keys under this prefix.
# ALIYUN_OSS_DEMO_PREFIX=demo/ali-oss-client-prototype/

# Keep the demo object after the run (default: false). Set to true to skip
# the demo's automatic cleanup — needed to curl-test the signed upload URL
# after the demo exits (see README → Testing a signed upload URL with curl).
# ALIYUN_OSS_KEEP_DEMO_OBJECT=true
