# Env template — copy to `.env` (git-ignored):  cp .env.example .env
# Load order (see shared/env.py): shell/CI env > .env.local > .env
# Everything here is developer-local; never commit real secrets.
# R2 credentials are placeholders — rclone.conf / PicList keep their own copies.
# Full setup: internal/bucket-design.md

# --- Bucket assets (R2/S3): local testing of the prefix rewrite ---
# Force-enable rewrite without editing mkdocs.yml (same as `poe server-bucket`).
# MKDOCS_BUCKET_ENABLED=true
# Override every mapping's base_url for testing (staging prefix).
# MKDOCS_BUCKET_BASE_URL=http://xxx.r2.dev/web-assets/img
# R2 credentials — create in R2 console (Manage R2 API Tokens).
# `poe bucket-sync pull` only needs read (Object Read + List Bucket);
# `poe bucket-upload` needs WRITE (Admin Read & Write, or Object Read +
# Object Write + List Bucket) — update the token below and re-run
# `poe rclone-config-init` before uploading.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
#
# bucket-sync settings — the rclone remote name is local-only (CI never
# syncs), so it lives here, NOT in mkdocs.yml. Other sync params (bucket /
# prefixes) default from mkdocs.yml `extra.bucket`; env overrides only
# locally. Priority: CLI arg > env here > mkdocs.yml.
# BUCKET_SYNC_REMOTE=web-assets-readonly
# BUCKET_SYNC_BUCKET=
# BUCKET_SYNC_PREFIX=assets/bucket/
# BUCKET_SYNC_REMOTE_PREFIX=data/img
#
# bucket-upload settings — rename rule / fallback name / temp dir / size
# limit default from mkdocs.yml `extra.bucket.upload`; env overrides apply
# locally only. Reuses BUCKET_SYNC_REMOTE/_BUCKET/_PREFIX/_REMOTE_PREFIX
# above (remote name is auto-detected from `rclone listremotes`; env is an
# override). Upload is dry-run by default — pass --confirm to actually upload.
# BUCKET_UPLOAD_RULE={Y}/{m}/{d}_{h}{i}{s}_{filename}
# BUCKET_UPLOAD_FALLBACK_NAME=noname
# BUCKET_UPLOAD_TMP_DIR=.bucket
# BUCKET_UPLOAD_MAX_SIZE_MB=10
#
# Proxy for rclone (native rclone env var, maps to `--http-proxy`; needed when
# R2 is unreachable directly, e.g. mainland China). Loaded from .env and
# inherited by the rclone subprocess. Standard HTTP(S)_PROXY also works.
# RCLONE_HTTP_PROXY=http://127.0.0.1:1095

# --- Site ---
# Analytics beacon token (public by design; empty disables).
# CF_ANALYTICS_TOKEN=cd22530495334b6097e23e273034f4cd
# Mermaid JS bundle: local copy first, falls back to this CDN on error.
# MERMAID_CDN_URL=
# Overrides used by self-hosted / CI builds.
# SITE_NAME=recycle.bin
# SITE_URL=https://xiongjia.github.io
# GIT_HASH=

# --- Local bot (auto PR) ---
# Fine-grained PAT of the personal account for the bot (see
# internal/bot-auto-pr-design.md → Credential Strategy for the one-time setup).
# Permissions: Contents: write + Pull requests: write + Actions: read.
# BOT_GH_TOKEN=
# Skip the python unittest step in the bot's local CI gate (default: run).
# Local escape hatch while master's tests are not yet self-isolating;
# keep off once the test isolation is merged to master.
# BOT_SKIP_TESTS=true
# Worktree base dir for bot runs (default: ~/.cache/<repo>-bot/worktrees/).
# BOT_WORKTREE_DIR=
# Base branch the bot forks from (default: master).
# BOT_BASE_BRANCH=master
# HTTP proxy for bot network calls (GitHub API / git push / mermaid download).
# Needed when GitHub is unreachable directly (e.g. mainland China).
# BOT_HTTP_PROXY=http://127.0.0.1:1095

# --- Bot Remote API (Phase 1: web management) ---
# Server bind address / port. Default 127.0.0.1:8100 — 8000 belongs to the
# mkdocs dev server. No auth by design; keep on localhost / a trusted
# network. The port is the webhook/nginx/tunnel target once TG lands.
# ⚠ POST /api/upload has NO auth: anyone who can reach the server can write
#   files (≤25MB each) into BOT_API_LOG_DIR/uploads — never expose the port
#   publicly without a reverse-proxy auth / firewall.
# BOT_API_HOST=127.0.0.1
# BOT_API_PORT=8100
# Runtime data dir: history JSONL (+ rotation) and uploads staging.
# Absolute path or repo-relative; default: repo-local .bot-api/
# BOT_API_LOG_DIR=.bot-api
# Run `poe bot cleanup` for stale worktrees at API startup (default true;
# set false to skip, e.g. in tests).
# BOT_API_STARTUP_CLEANUP=true
